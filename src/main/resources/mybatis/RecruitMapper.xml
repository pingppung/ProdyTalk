<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTDMapper3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.ProdyTalk.mapper.RecruitMapper">

    <select id="selectAllRecruits" resultType="com.example.ProdyTalk.vo.RecruitVO">
        SELECT * from recruit ORDER BY recruit_id DESC;
    </select>

    <select id="selectStudyRecruits" resultType="com.example.ProdyTalk.vo.RecruitVO">
        SELECT * from recruit where room_type = '스터디' ORDER BY recruit_id DESC;
    </select>

    <select id="selectProjectRecruits" resultType="com.example.ProdyTalk.vo.RecruitVO">
        SELECT * from recruit where room_type = '프로젝트' ORDER BY recruit_id DESC;
    </select>

    <insert id="insertRecruit" parameterType="com.example.ProdyTalk.vo.RecruitVO">
        insert into recruit (room_type,title,content,user_id,date)
        values (#{room_type},#{title},#{content},#{user_id},#{date})
    </insert>

    <select id="selectRecruitById" resultType="com.example.ProdyTalk.vo.RecruitVO">
        SELECT * from recruit where recruit_id = #{recruit_id}
    </select>

    <update id="updateRecruit" parameterType="com.example.ProdyTalk.vo.RecruitVO">
        update recruit
        set room_type = #{room_type}, title = #{title}, content = #{content}, user_id = #{user_id}
        where recruit_id = #{recruit_id}
    </update>

    <delete id="deleteRecruit" parameterType="com.example.ProdyTalk.vo.RecruitVO">
        delete from recruit
        where recruit_id = #{recruit_id}
    </delete>
</mapper>
